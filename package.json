{
  "name": "cadence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,realtime -c \"#ff3d9a,#6e7bff\" --kill-others-on-fail \"npm:dev:next\" \"npm:dev:realtime\"",
    "dev:next": "next dev",
    "dev:realtime": "npm run dev --workspace @cadence/realtime",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @cadence/realtime",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.40.0",
    "mongoose": "^9.9.4",
    "next": "16.3.4",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.20.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "description": "A music streaming app where recommendations appear on intent, not by default.",
  "workspaces": [
    "realtime"
  ],
  "engines": {
    "node": ">=20.9.0"
  }
}
