{
  "name": "@cadence/realtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone realtime server for Cadence listen-together rooms.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env.local src/index.ts",
    "start": "tsx --env-file-if-exists=../.env.local src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  }
}
