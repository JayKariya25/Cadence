# Copy this file to .env.local and fill in the blanks:
#   cp .env.example .env.local
# Only JAMENDO_CLIENT_ID needs a value you do not already have.

# ── Database ─────────────────────────────────────────────────────────────────
# Points at the MongoDB started by docker-compose.yml, which publishes on
# 27018 rather than 27017 so it cannot be shadowed by a mongod already running
# on this machine (see the comment in docker-compose.yml). The app makes no
# assumption that the database is local: a hosted connection string
# (mongodb+srv://...) works here unchanged.
MONGODB_URI=mongodb://localhost:27018/cadence

# ── Music catalogue ──────────────────────────────────────────────────────────
# Free key, no credit card: https://devportal.jamendo.com/ → sign up → create
# an application → copy its "Client ID". Server-side only; never sent to the
# browser. Without it the app still runs and serves whatever is already cached
# in MongoDB — only fetching new music from Jamendo fails.
JAMENDO_CLIENT_ID=

# How long a cached Track document stays fresh before it is refetched (hours).
TRACK_CACHE_TTL_HOURS=168
# How long a cached /tracks/similar result stays fresh (hours). Used in Phase 3.
SIMILAR_CACHE_TTL_HOURS=72

# ── Realtime: listen-together rooms (Phase 6) ────────────────────────────────
# Port for the standalone Socket.io server in /realtime. It is a separate
# process because an App Router route handler cannot hold a WebSocket open.
REALTIME_PORT=4000
# Where the browser dials that server. Public by nature — it is only a URL.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# ── Auth (Phase 2) ───────────────────────────────────────────────────────────
# Generate one with:  openssl rand -base64 32
AUTH_SECRET=
# The origin this app is served from.
AUTH_URL=http://localhost:3000

# ── Optional: Google sign-in (Phase 2) ───────────────────────────────────────
# Leave BOTH of these blank and Google sign-in is hidden entirely; email and
# password sign-in still works, so a fresh clone needs no Google Cloud project.
# To enable: https://console.cloud.google.com/ → APIs & Services → Credentials
# → OAuth client ID → Web application, with the authorised redirect URI
# http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
